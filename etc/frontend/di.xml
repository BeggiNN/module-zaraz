<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Customer\CustomerData\SectionPoolInterface">
        <arguments>
            <argument name="sectionSourceMap" xsi:type="array">
                <item name="perspective-zaraz" xsi:type="string">Perspective\Zaraz\CustomerData\EventsSection</item>
            </argument>
        </arguments>
    </type>
    <!-- Product List Viewed / Product Clicked for list blocks (resolvers: Model\ProductList\ResolverPool) -->
    <type name="Magento\Catalog\Block\Product\ListProduct">
        <plugin name="perspective_zaraz_list_events" type="Perspective\Zaraz\Plugin\Catalog\AppendListEvents"/>
    </type>
    <type name="Magento\Catalog\Block\Product\ProductList\Related">
        <plugin name="perspective_zaraz_list_events" type="Perspective\Zaraz\Plugin\Catalog\AppendListEvents"/>
    </type>
    <type name="Magento\Catalog\Block\Product\ProductList\Upsell">
        <plugin name="perspective_zaraz_list_events" type="Perspective\Zaraz\Plugin\Catalog\AppendListEvents"/>
    </type>
    <type name="Magento\Checkout\Block\Cart\Crosssell">
        <plugin name="perspective_zaraz_list_events" type="Perspective\Zaraz\Plugin\Catalog\AppendListEvents"/>
    </type>
    <type name="Magento\CatalogWidget\Block\Product\ProductsList">
        <plugin name="perspective_zaraz_list_events" type="Perspective\Zaraz\Plugin\Catalog\AppendListEvents"/>
    </type>
</config>
