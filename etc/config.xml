<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <perspective_zaraz>
            <general>
                <enabled>1</enabled>
                <debug>0</debug>
                <script_mode>auto</script_mode>
                <script_url>/cdn-cgi/zaraz/i.js</script_url>
                <script_attributes>data-cfasync="false"</script_attributes>
                <list_chunk_size>20</list_chunk_size>
                <checkout_paths/>
                <success_paths/>
            </general>
            <events>
                <events>{
                    "_product_list_viewed":{"event":"product_list_viewed","enabled":"1",
                        "name":"","browser":"1","server":"0"},
                    "_products_searched":{"event":"products_searched","enabled":"1",
                        "name":"","browser":"1","server":"0"},
                    "_product_clicked":{"event":"product_clicked","enabled":"1","name":"","browser":"1","server":"0"},
                    "_product_viewed":{"event":"product_viewed","enabled":"1","name":"","browser":"1","server":"0"},
                    "_product_added":{"event":"product_added","enabled":"1","name":"","browser":"1","server":"0"},
                    "_product_removed":{"event":"product_removed","enabled":"1","name":"","browser":"1","server":"0"},
                    "_product_added_to_wishlist":{"event":"product_added_to_wishlist","enabled":"1",
                        "name":"","browser":"1","server":"0"},
                    "_product_added_to_compare":{"event":"product_added_to_compare","enabled":"1",
                        "name":"","browser":"1","server":"0"},
                    "_cart_viewed":{"event":"cart_viewed","enabled":"1","name":"","browser":"1","server":"0"},
                    "_checkout_started":{"event":"checkout_started","enabled":"1","name":"","browser":"1","server":"0"},
                    "_checkout_step_viewed":{"event":"checkout_step_viewed","enabled":"0",
                        "name":"","browser":"1","server":"0"},
                    "_checkout_step_completed":{"event":"checkout_step_completed","enabled":"0",
                        "name":"","browser":"1","server":"0"},
                    "_shipping_info_entered":{"event":"shipping_info_entered","enabled":"1",
                        "name":"","browser":"1","server":"0"},
                    "_payment_info_entered":{"event":"payment_info_entered","enabled":"1",
                        "name":"","browser":"1","server":"0"},
                    "_order_completed":{"event":"order_completed","enabled":"1","name":"","browser":"1","server":"1"},
                    "_viewed_promotion":{"event":"viewed_promotion","enabled":"1","name":"","browser":"1","server":"0"},
                    "_clicked_promotion":{"event":"clicked_promotion","enabled":"1",
                        "name":"","browser":"1","server":"0"},
                    "_coupon_applied":{"event":"coupon_applied","enabled":"1","name":"","browser":"1","server":"0"},
                    "_coupon_removed":{"event":"coupon_removed","enabled":"1","name":"","browser":"1","server":"0"},
                    "_login":{"event":"login","enabled":"1","name":"","browser":"1","server":"0"},
                    "_sign_up":{"event":"sign_up","enabled":"1","name":"","browser":"1","server":"0"}
                }</events>
            </events>
            <product>
                <id_source>sku</id_source>
                <send_sku>1</send_sku>
                <configurable_mode>parent</configurable_mode>
                <view_send_children>0</view_send_children>
                <variant_enabled>1</variant_enabled>
                <variant_source>options</variant_source>
                <brand_enabled>0</brand_enabled>
                <brand_attribute>manufacturer</brand_attribute>
            </product>
            <price>
                <currency_scope>display</currency_scope>
                <product_price_tax>0</product_price_tax>
                <order_total_source>grand_total</order_total_source>
                <exclude_tax>0</exclude_tax>
                <exclude_shipping>0</exclude_shipping>
                <exclude_shipping_tax>0</exclude_shipping_tax>
                <shipping_incl_tax>0</shipping_incl_tax>
            </price>
            <order>
                <skip_zero_total>1</skip_zero_total>
                <skip_statuses/>
                <affiliation/>
            </order>
            <category>
                <excluded/>
                <use_next_available>1</use_next_available>
                <depth_limit>0</depth_limit>
                <depth_direction>root</depth_direction>
                <format>path</format>
                <separator>/</separator>
            </category>
            <properties>
                <stock_status>0</stock_status>
                <stock_status_key>stock_status</stock_status_key>
                <review_count>0</review_count>
                <review_count_key>review_count</review_count_key>
                <rating>0</rating>
                <rating_key>rating</rating_key>
                <on_sale>0</on_sale>
                <on_sale_key>on_sale</on_sale_key>
                <custom_attributes/>
            </properties>
            <user>
                <customer_id>0</customer_id>
                <customer_id_key>customer_id</customer_id_key>
                <customer_group>1</customer_group>
                <customer_group_key>customer_group</customer_group_key>
                <page_type>1</page_type>
                <page_type_key>page_type</page_type_key>
                <page_name>0</page_name>
                <page_name_key>page_name</page_name_key>
                <email_hash>0</email_hash>
                <email_hash_key>email_sha256</email_hash_key>
            </user>
            <attribution>
                <enabled>1</enabled>
                <ttl_minutes>1440</ttl_minutes>
            </attribution>
            <ads>
                <enabled>0</enabled>
                <new_customer>1</new_customer>
                <lifetime_value>1</lifetime_value>
                <cart_items>1</cart_items>
                <enhanced_conversions>0</enhanced_conversions>
                <ec_fields>email,phone</ec_fields>
                <skip_zero_total>1</skip_zero_total>
            </ads>
        </perspective_zaraz>
    </default>
</config>
